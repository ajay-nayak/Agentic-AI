# ==============================================================================
# Agentic AI Repository - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate the values below with your valid keys.
# DO NOT commit your actual '.env' file containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Providers
# ------------------------------------------------------------------------------
# OpenAI API Key (Optional if using local Ollama models)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Groq API Key (Optional for ultra-fast Llama/Mixtral inference)
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Ollama Base URL (Default local Ollama server address)
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# 2. Search & External Tools
# ------------------------------------------------------------------------------
# Tavily Search API Key (Required for search agent live internet retrieval)
# Get your key at: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# ------------------------------------------------------------------------------
# 3. Observability & Tracing (LangSmith)
# ------------------------------------------------------------------------------
# Set to 'true' to enable automatic execution tracing
LANGSMITH_TRACING=true

# Endpoint: US default is https://api.smith.langchain.com
# For EU accounts use: https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# LangSmith API Key (Get from https://smith.langchain.com/settings)
LANGSMITH_API_KEY=your_langsmith_api_key_here

# Name of the tracing project in LangSmith dashboard
LANGSMITH_PROJECT=agentic-ai-portfolio

# ------------------------------------------------------------------------------
# 4. General Configuration
# ------------------------------------------------------------------------------
# Default Log Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
